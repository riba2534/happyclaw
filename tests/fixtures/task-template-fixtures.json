{
  "categories": [
    {
      "category_id": "system_log_inspection",
      "category_name": "系统运维与日志巡检任务",
      "template": {
        "name": "系统运维日志巡检模板",
        "description": "用于定时分析指定项目的应用日志，发现异常堆栈并生成巡检报告",
        "prompt_template": "请对项目 {{project}} 在 {{date}} 的运行日志进行巡检，读取目录 {{input_dir}} 下的日志文件。关注级别 {{log_level}} 以上的异常堆栈，错误阈值设为 {{threshold}} 次。将巡检结果写入交付产物 reports/inspection_{{project}}_{{date}}.md，并在结束时显式声明该交付产物。",
        "parameter_definitions": [
          {
            "name": "project",
            "label": "项目标识",
            "type": "string",
            "required": true,
            "description": "目标微服务或子系统名称"
          },
          {
            "name": "date",
            "label": "巡检日期",
            "type": "date",
            "required": true,
            "description": "执行巡检的目标业务日期 (YYYY-MM-DD)"
          },
          {
            "name": "input_dir",
            "label": "日志输入目录",
            "type": "path",
            "required": true,
            "description": "工作区内的相对日志目录"
          },
          {
            "name": "log_level",
            "label": "日志级别",
            "type": "string",
            "required": false,
            "default_value": "ERROR",
            "description": "最低告警过滤日志级别 (INFO, WARN, ERROR, FATAL)"
          },
          {
            "name": "threshold",
            "label": "告警阈值",
            "type": "number",
            "required": false,
            "default_value": "10",
            "description": "触发高危告警的错误频次阈值"
          }
        ],
        "default_schedule_type": "cron",
        "default_schedule_value": "0 9 * * *",
        "default_context_mode": "isolated",
        "default_execution_type": "agent",
        "default_execution_mode": "container"
      },
      "fixtures": [
        {
          "fixture_id": "sys_fix_1",
          "params": {
            "project": "happyclaw-core",
            "date": "2026-09-01",
            "input_dir": "logs/core",
