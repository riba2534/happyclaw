          }
        }
      ]
    },
    {
      "category_id": "business_metrics_report",
      "category_name": "业务指标报表与数据聚合任务",
      "template": {
        "name": "每日业务指标报表统计模板",
        "description": "用于定时聚合业务线核心指标，输出结构化报表交付文件",
        "prompt_template": "请统计业务线 {{business_line}} 在 {{report_date}} 的业务运行指标。数据源目录为 {{source_dir}}，按维度 {{aggregate_dimension}} 进行汇总，导出格式为 {{output_format}}。最终生成每日交付报告 reports/daily_metrics_{{report_date}}.{{output_format}}，并显式声明该交付文件。",
        "parameter_definitions": [
          {
            "name": "business_line",
            "label": "业务线标识",
            "type": "string",
            "required": true,
            "description": "所属业务单元标识"
          },
          {
            "name": "report_date",
            "label": "报表日期",
            "type": "date",
            "required": true,
            "description": "统计数据的业务日期 (YYYY-MM-DD)"
          },
          {
            "name": "source_dir",
            "label": "数据源目录",
            "type": "path",
            "required": true,
            "description": "工作区内的数据文件相对目录"
          },
          {
            "name": "aggregate_dimension",
            "label": "汇总维度",
            "type": "string",
            "required": false,
            "default_value": "hourly",
            "description": "聚合粒度 (hourly, daily, channel, user)"
          },
          {
            "name": "output_format",
            "label": "输出格式",
            "type": "string",
            "required": false,
            "default_value": "json",
            "description": "报表文件后缀格式 (json, csv, md)"
          }
        ],
        "default_schedule_type": "cron",
        "default_schedule_value": "0 2 * * *",
        "default_context_mode": "isolated",
        "default_execution_type": "agent",
        "default_execution_mode": "container"
      },
      "fixtures": [
        {
